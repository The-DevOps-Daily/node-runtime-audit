[Unit]
Description=PM2 process manager
After=network.target

[Service]
Type=forking
User=deploy
Environment=PATH={ROOT}/nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=PM2_HOME=/home/deploy/.pm2
PIDFile=/home/deploy/.pm2/pm2.pid
ExecStart={ROOT}/nvm/versions/node/v24.14.0/lib/node_modules/pm2/bin/pm2 resurrect
ExecReload={ROOT}/nvm/versions/node/v24.14.0/lib/node_modules/pm2/bin/pm2 reload all
ExecStop={ROOT}/nvm/versions/node/v24.14.0/lib/node_modules/pm2/bin/pm2 kill

[Install]
WantedBy=multi-user.target
